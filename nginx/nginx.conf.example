# Example reverse proxy for the Cognigy MCP server, terminating TLS.
# Copy to nginx/nginx.conf, fill in your domain + certificate paths, and run:
#   docker compose --profile with-nginx up -d
#
# Get a cert with certbot (standalone or webroot mode) and point
# ssl_certificate/ssl_certificate_key at the resulting files, or bring your
# own corporate-issued certificate.

server {
    listen 80;
    server_name cognigy-mcp.internal.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name cognigy-mcp.internal.example.com;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    # Cognigy API keys travel in request headers on every call - never allow
    # this proxy to fall back to plain HTTP, and don't log these headers.
    location /mcp {
        proxy_pass http://mcp:8000/mcp;
        proxy_http_version 1.1;

        # Streamable HTTP can hold a connection open for server-sent events;
        # don't let nginx's defaults cut that off or buffer it.
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 3600s;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
